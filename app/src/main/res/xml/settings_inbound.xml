<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/cag_mixed_inbound">
        <SwitchPreference
            app:icon="@drawable/ic_baseline_block_24"
            app:key="disable_mixed_inbound"
            app:summary="@string/disable_mixed_inbound_sum"
            app:title="@string/disable_mixed_inbound" />
        <EditTextPreference
            app:dialogMessage="@string/http_proxy_bypass_dialog_message"
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="httpProxyBypass"
            app:title="@string/http_proxy_bypass" />
    </PreferenceCategory>

    <!-- The port, the LAN switch, the credentials and the custom inbound JSON moved to the LAN sharing screen, so
         the bind address, the address to dial and the port stay visible together. -->
    <PreferenceCategory app:title="@string/lan_share_title">
        <Preference
            app:icon="@drawable/ic_social_share"
            app:key="lanShare"
            app:summary="@string/lan_share_open_hint"
            app:title="@string/lan_share_title" />
    </PreferenceCategory>
</PreferenceScreen>